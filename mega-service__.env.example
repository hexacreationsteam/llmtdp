# MEGA does not provide a standard API key for this megajs account-login flow.
# Enter your MEGA account details only in this private service's environment settings.
MEGA_EMAIL=
MEGA_PASSWORD=

# Create your own separate passcode for unlocking LocalForge MEGA sync.
SYNC_PASSCODE=

# Generate a long random secret and use the same value for the Cloudflare Worker secret MEGA_SERVICE_TOKEN.
SERVICE_TOKEN=
PORT=8788
